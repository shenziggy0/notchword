<Window x:Class="Englishwords.Win.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Englishwords 设置"
        Width="660"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5">
    <TabControl Margin="12" Background="#18181B" BorderBrush="#27272A">
        <!-- 通用设置 -->
        <TabItem Header="通用">
            <StackPanel Margin="16">
                <TextBlock Text="主面板形态" Foreground="#A1A1AA" Margin="0,0,0,6" />
                <ComboBox x:Name="PanelStyleCombo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,16"
                          SelectionChanged="PanelStyleCombo_SelectionChanged">
                    <ComboBoxItem Content="顶部可避让模拟刘海" Tag="Notch" />
                    <ComboBoxItem Content="鼠标旁轻量悬浮窗" Tag="Floating" />
                </ComboBox>

                <CheckBox x:Name="SelectionToggle" Content="启用鼠标拖选自动划词" Foreground="#F4F4F5" Margin="0,0,0,10"
                          Checked="GeneralOption_Changed" Unchecked="GeneralOption_Changed" />
                <CheckBox x:Name="AutoHideToggle" Content="结果展示 5 秒后自动收起" Foreground="#F4F4F5" Margin="0,0,0,10"
                          Checked="GeneralOption_Changed" Unchecked="GeneralOption_Changed" />
                <CheckBox x:Name="LaunchAtLoginToggle" Content="开机自动启动" Foreground="#F4F4F5" Margin="0,0,0,20"
                          Checked="LaunchAtLoginToggle_Changed" Unchecked="LaunchAtLoginToggle_Changed" />

                <TextBlock Text="全局快捷键" Foreground="#A1A1AA" Margin="0,0,0,8" />
                <TextBlock x:Name="HotKeySummaryText" Foreground="#D4D4D8" Margin="0,0,0,12" />
                <TextBlock x:Name="OcrStatusText" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,12" />
                <Button Content="打开运行日志目录" Width="160" HorizontalAlignment="Left" Click="OpenLogFolder_Click" Padding="8,4" />
            </StackPanel>
        </TabItem>

        <!-- 词典设置 -->
        <TabItem Header="词典">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="DictSourcesList" Background="#09090B" Foreground="#F4F4F5" BorderBrush="#27272A">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <CheckBox IsChecked="{Binding Enabled}" Checked="DictSource_Changed" Unchecked="DictSource_Changed" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" Foreground="#F4F4F5" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="导入 StarDict (.ifo)" Click="ImportStarDict_Click" Padding="10,5" Margin="0,0,8,0" />
                    <Button Content="上移" Click="MoveUpDict_Click" Padding="10,5" Margin="0,0,8,0" />
                    <Button Content="下移" Click="MoveDownDict_Click" Padding="10,5" Margin="0,0,8,0" />
                    <Button Content="移除选中" Click="RemoveDict_Click" Padding="10,5" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- 翻译服务 -->
        <TabItem Header="翻译服务">
            <StackPanel Margin="16">
                <CheckBox x:Name="OnlineEnabledToggle" Content="启用联网翻译（内置词库未命中或短句时使用）"
                          Foreground="#F4F4F5" Margin="0,0,0,12"
                          Checked="OnlineEnabled_Changed" Unchecked="OnlineEnabled_Changed" />

                <TextBlock Text="服务预设" Foreground="#A1A1AA" Margin="0,0,0,4" />
                <ComboBox x:Name="PresetCombo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10"
                          SelectionChanged="PresetCombo_SelectionChanged" />

                <TextBlock Text="接口地址 (Base URL)" Foreground="#A1A1AA" Margin="0,0,0,4" />
                <TextBox x:Name="AddressBox" Margin="0,0,0,10" Padding="6,4" LostFocus="OnlineConfig_LostFocus" />

                <TextBlock Text="模型名称" Foreground="#A1A1AA" Margin="0,0,0,4" />
                <TextBox x:Name="ModelBox" Margin="0,0,0,10" Padding="6,4" LostFocus="OnlineConfig_LostFocus" />

                <TextBlock Text="API 密钥（DPAPI 加密保存，不落明文）" Foreground="#A1A1AA" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <PasswordBox x:Name="ApiKeyBox" Width="320" Padding="6,4" />
                    <Button Content="保存密钥" Click="SaveKey_Click" Padding="10,4" Margin="8,0,0,0" />
                    <Button Content="清除密钥" Click="ClearKey_Click" Padding="10,4" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="测试连接" Click="TestOnline_Click" Padding="12,5" Margin="0,0,12,0" />
                    <TextBlock x:Name="OnlineStatusText" VerticalAlignment="Center" Foreground="#F59E0B" />
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
