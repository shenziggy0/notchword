<Window x:Class="Englishwords.Win.Views.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PageWindow}" Title="Englishwords 笔记本"
        Width="728" MinWidth="428" Height="590" MinHeight="330" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="EmptyMessage" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EmptyIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24,16,24,22">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="复习 3 个词" Tag="primary" Margin="10,0,0,0" Click="Review_Click"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="笔记本" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>
        <TabControl x:Name="Pages" AutomationProperties.Name="笔记本栏目">
            <TabItem Header="收藏">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}"
                               Text="{Binding Items.Count, ElementName=FavoritesList, StringFormat='已收藏 {0} 个单词'}"/>
                    <Border Style="{StaticResource ContentCard}" Padding="6">
                        <Grid>
                            <ListBox x:Name="FavoritesList" AutomationProperties.Name="收藏单词" FontSize="15"
                                     PreviewKeyDown="LookupList_KeyDown" MouseDoubleClick="WordList_MouseDoubleClick">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Data="M 1,1 L 6,6 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <StackPanel Loaded="FavoriteDetails_Loaded">
                                        <TextBlock Text="{Binding Word}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel/>
                                    </StackPanel>
                                    </DockPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Style="{StaticResource EmptyMessage}" DataContext="{Binding ElementName=FavoritesList}">
                                <Path Style="{StaticResource EmptyIcon}" Data="M 5,21 L 5,4 Q 5,2 7,2 L 17,2 Q 19,2 19,4 L 19,21 12,16 Z"/>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" Text="还没有收藏"/>
                                <TextBlock Margin="0,6,0,0" TextAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Text="点查词面板的书签，就能在这里找到那个词。"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="历史">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}" Text="{Binding Items.Count, ElementName=HistoryList, StringFormat='最近 {0} 条查词记录'}"/>
                    <Border Style="{StaticResource ContentCard}" Padding="6">
                        <Grid>
                            <ListBox x:Name="HistoryList" AutomationProperties.Name="查词历史" PreviewKeyDown="LookupList_KeyDown" MouseDoubleClick="HistoryList_MouseDoubleClick">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Word}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Source}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Style="{StaticResource EmptyMessage}" DataContext="{Binding ElementName=HistoryList}">
                                <Path Style="{StaticResource EmptyIcon}" Data="M 2,4 L 2,9 7,9 M 2,9 A 9,9 0 1 1 3,17 M 12,6 L 12,12 16,14"/>
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="15" Text="还没有查词记录"/>
                                <TextBlock Margin="0,6,0,0" TextAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Text="查过的单词会按时间出现在这里。"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="统计">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,5,0">
                        <Border Style="{StaticResource ContentCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="累计查词" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
                                <TextBlock x:Name="TotalCountText" Margin="0,2,0,12" FontSize="32" FontWeight="Bold"/>
                                <Border Style="{StaticResource RowRule}" Margin="0,0,0,12"/>
                                <TextBlock Text="最近七天" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="DailyList">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="13"/>
                                            <Grid Grid.Column="1" Height="7">
                                                <Border Background="{DynamicResource ControlBrush}" CornerRadius="4"/>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4">
                                                    <Border.RenderTransform><ScaleTransform ScaleX="{Binding Fraction}"/></Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" FontSize="13"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource GroupTitle}" Text="最常查的 20 个词"/>
                        <Border Style="{StaticResource ContentCard}" Padding="6">
                            <Grid>
                                <ListBox x:Name="FrequentList" MaxHeight="360" AutomationProperties.Name="最常查的单词"/>
                                <TextBlock Foreground="{DynamicResource SecondaryBrush}" Margin="12" IsHitTestVisible="False" Text="有查词记录后，这里会显示单词和次数。">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=FrequentList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
