<Window x:Class="Englishwords.Win.Views.NotebookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Englishwords 笔记本"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5">
    <TabControl Margin="12" Background="#18181B" BorderBrush="#27272A">
        <TabItem Header="收藏">
            <ListBox x:Name="FavoritesList"
                     Background="#09090B"
                     Foreground="#F4F4F5"
                     BorderBrush="#27272A"
                     MouseDoubleClick="WordList_MouseDoubleClick"
                     Margin="6" />
        </TabItem>

        <TabItem Header="历史">
            <ListBox x:Name="HistoryList"
                     Background="#09090B"
                     Foreground="#F4F4F5"
                     BorderBrush="#27272A"
                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                     Margin="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Word}" FontWeight="SemiBold" Foreground="#F4F4F5" />
                            <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="#A1A1AA" />
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="#71717A" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </TabItem>

        <TabItem Header="统计">
            <StackPanel Margin="12">
                <TextBlock x:Name="TotalCountText" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,12" />
                <TextBlock Text="近七天查词次数" Foreground="#A1A1AA" Margin="0,0,0,6" />
                <ItemsControl x:Name="DailyList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Foreground="#D4D4D8" />
                                <Border Grid.Column="1" HorizontalAlignment="Left" Background="#3B82F6" Height="12" CornerRadius="3" Width="{Binding BarWidth}" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#A1A1AA" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="常查单词 Top 20" Foreground="#A1A1AA" Margin="0,0,0,6" />
                <ListBox x:Name="FrequentList" Height="180" Background="#09090B" Foreground="#F4F4F5" BorderBrush="#27272A" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
