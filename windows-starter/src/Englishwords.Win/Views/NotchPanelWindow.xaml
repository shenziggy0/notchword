<Window x:Class="Englishwords.Win.Views.NotchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">
    <Border x:Name="RootBorder"
            Background="#0C0C0E"
            BorderBrush="#27272A"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,10"
            MaxWidth="440"
            MinWidth="260">
        <StackPanel>
            <!-- 头部：词头 / 音标 / 操作按钮 -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Englishwords"
                               Foreground="#F4F4F5"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="250" />
                    <TextBlock x:Name="PhoneticText"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               Margin="8,2,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SpeakButton"
                            Content="🔊"
                            ToolTip="朗读"
                            Click="SpeakButton_Click"
                            Background="Transparent"
                            Foreground="#D4D4D8"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,2"
                            Margin="4,0,0,0" />
                    <Button x:Name="FavoriteButton"
                            Content="☆"
                            ToolTip="收藏"
                            Click="FavoriteButton_Click"
                            Background="Transparent"
                            Foreground="#FBBF24"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Padding="4,0"
                            Margin="4,0,0,0" />
                    <Button x:Name="CloseButton"
                            Content="✕"
                            ToolTip="关闭 (Esc)"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="#71717A"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,2"
                            Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 紧凑态摘要（仅刘海未展开时显示） -->
            <TextBlock x:Name="CompactSummaryText"
                       Foreground="#D4D4D8"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="380"
                       Visibility="Collapsed" />

            <!-- 展开态完整内容 -->
            <StackPanel x:Name="ExpandedContent">
                <!-- 词性 & 考试标签 -->
                <ItemsControl x:Name="TagsList" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#18181B"
                                    BorderBrush="#27272A"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" Foreground="#A1A1AA" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 三色词根词缀拆解 -->
                <ItemsControl x:Name="SegmentsList" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,3"
                                    Margin="0,0,5,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{Binding Foreground}"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding GlossText}"
                                               Foreground="#D4D4D8"
                                               FontSize="11"
                                               Margin="4,1,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="OriginText"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="Collapsed" />

                <!-- 原文（仅短句翻译展示） -->
                <TextBlock x:Name="OriginalSentenceText"
                           Foreground="#A1A1AA"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="Collapsed" />

                <!-- 释义 / 译文正文 -->
                <TextBlock x:Name="BodyText"
                           Foreground="#E4E4E7"
                           FontSize="13.5"
                           LineHeight="20"
                           TextWrapping="Wrap" />

                <!-- 底部来源与降级提示 -->
                <StackPanel Margin="0,8,0,0">
                    <TextBlock x:Name="NoteText"
                               Foreground="#F59E0B"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="SourceText"
                               Foreground="#71717A"
                               FontSize="11"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
