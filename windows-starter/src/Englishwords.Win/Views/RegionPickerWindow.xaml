<Window x:Class="Englishwords.Win.Views.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#44000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        ResizeMode="NoResize">
    <Canvas x:Name="OverlayCanvas">
        <Rectangle x:Name="SelectionRect"
                   Stroke="#3B82F6"
                   StrokeThickness="2"
                   Fill="#223B82F6"
                   Visibility="Collapsed" />
        <Border Background="#CC09090B"
                CornerRadius="8"
                Padding="12,6"
                Canvas.Left="24"
                Canvas.Top="24">
            <TextBlock Text="拖动框选要识别的英文区域 · 按 Esc 取消"
                       Foreground="#F4F4F5"
                       FontSize="13" />
        </Border>
    </Canvas>
</Window>
